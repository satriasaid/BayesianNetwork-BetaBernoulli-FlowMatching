\newlabel{tab:Cconf}{{5}{5}{Baseline setup. Trained completely from scratch --- no pretrained weights, nothing frozen. Implemented in PyTorch [8]; the reference implementation [6] was consulted for the 2-D starting point. \file {C\_reproduction\_record.json}\relax }{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Left:} training and held-out loss, with checkpoints marked. Held-out loss never rises more than $0.006$ above training loss, so there is no overfitting at this size. \textbf  {Right:} the journey from noise to drawing. The rough shape is set by about $t{=}0.3$--$0.5$ and the later steps just sharpen the lines --- what you would expect if the paths are nearly straight.\relax }}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:Ctrain}{{3}{6}{\textbf {Left:} training and held-out loss, with checkpoints marked. Held-out loss never rises more than $0.006$ above training loss, so there is no overfitting at this size. \textbf {Right:} the journey from noise to drawing. The rough shape is set by about $t{=}0.3$--$0.5$ and the later steps just sharpen the lines --- what you would expect if the paths are nearly straight.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}C3--C4. Controlled comparisons and scoring}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Both comparisons. The margin of error is $\pm 0.041$ throughout ($n{=}96$), so any gap under about $0.09$ means nothing. \leavevmode {\color  {gray}\small  \texttt  {C\_all\_results.csv}}\relax }}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:Cres}{{6}{6}{Both comparisons. The margin of error is $\pm 0.041$ throughout ($n{=}96$), so any gap under about $0.09$ means nothing. \file {C\_all\_results.csv}\relax }{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Matched grids with the same seeds down each column, showing the first 12 of 32 seeds, failures included. \textbf  {Left (Q1):} only the checkpoint changes. The drawings clearly get better by eye --- epoch-5 cats are scribbly, epoch-60 cats have clean ears and faces --- even though the recognisability \emph  {score} hardly moved. \textbf  {Right (Q2):} only the number of steps changes. The 2-step row is visibly faint and washed out, while 10 and 50 steps look almost the same. All 96 drawings for all 14 setups, including raw \texttt  {.npz} arrays, are in \leavevmode {\color  {gray}\small  \texttt  {results/partC/sample\_grids/}}.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:Cgrids}{{4}{7}{Matched grids with the same seeds down each column, showing the first 12 of 32 seeds, failures included. \textbf {Left (Q1):} only the checkpoint changes. The drawings clearly get better by eye --- epoch-5 cats are scribbly, epoch-60 cats have clean ears and faces --- even though the recognisability \emph {score} hardly moved. \textbf {Right (Q2):} only the number of steps changes. The 2-step row is visibly faint and washed out, while 10 and 50 steps look almost the same. All 96 drawings for all 14 setups, including raw \texttt {.npz} arrays, are in \file {results/partC/sample\_grids/}.\relax }{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}C5. What the results mean}{7}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Left:} a random (not hand-picked) sample of the real \emph  {training} drawings, looked at before training. Several are unclear even to a person --- they are 20-second public doodles --- and that is what sets the $0.8375$ ceiling rather than $1.0$. \textbf  {Right:} the copying check. Generated drawings sit at average distance $16.62$ from their closest training drawing versus $15.69$ for real held-out drawings, and even the six closest pairs share only a rough layout, not strokes.\relax }}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:Cdata}{{5}{8}{\textbf {Left:} a random (not hand-picked) sample of the real \emph {training} drawings, looked at before training. Several are unclear even to a person --- they are 20-second public doodles --- and that is what sets the $0.8375$ ceiling rather than $1.0$. \textbf {Right:} the copying check. Generated drawings sit at average distance $16.62$ from their closest training drawing versus $15.69$ for real held-out drawings, and even the six closest pairs share only a rough layout, not strokes.\relax }{figure.caption.10}{}}
