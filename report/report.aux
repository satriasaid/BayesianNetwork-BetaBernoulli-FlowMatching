\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Matched grids, identical seeds down the columns, first 12 of 32 seeds shown; failures included. \textbf  {Left (Q1):} only the checkpoint differs. Visual quality clearly improves --- epoch-5 cats are scribbly, epoch-60 cats have clean ears and faces, epoch-60 fish are crisp --- even though the recognisability \emph  {metric} moved within noise. \textbf  {Right (Q2):} only the ODE step count differs; the 2-step row is visibly faint and washed out, while 10 and 50 steps are near-indistinguishable. Complete 96-sample sets for all 14 configurations, including \texttt  {.npz} arrays, are in \leavevmode {\color  {gray}\small  \texttt  {results/partC/sample\_grids/}}.\relax }}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:Cgrids}{{4}{6}{Matched grids, identical seeds down the columns, first 12 of 32 seeds shown; failures included. \textbf {Left (Q1):} only the checkpoint differs. Visual quality clearly improves --- epoch-5 cats are scribbly, epoch-60 cats have clean ears and faces, epoch-60 fish are crisp --- even though the recognisability \emph {metric} moved within noise. \textbf {Right (Q2):} only the ODE step count differs; the 2-step row is visibly faint and washed out, while 10 and 50 steps are near-indistinguishable. Complete 96-sample sets for all 14 configurations, including \texttt {.npz} arrays, are in \textcolor {gray}{\small \texttt {results/partC/sample\_grids/}}.\relax }{figure.caption.9}{}}
